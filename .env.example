# Copy to .env and adjust values for your environment.
# For production, prefer immutable image digests.

# Main Caddy WAF image
CADDY_WAF_IMAGE=ghcr.io/miguel-devops/caddy-waf:latest # Change for pinned digest in production

# Optional demo backend for local validation
EXAMPLE_APP_IMAGE=containous/whoami:latest

# Domain handled by Caddy (use your real FQDN in production)
SITE_ADDRESS=localhost

# Upstream backend target
BACKEND_UPSTREAM=example-app:80

# Optional ACME email (recommended in real production)
ACME_EMAIL=
